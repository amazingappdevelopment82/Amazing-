.ngx-datatable.material.cell-selection .datatable-body-cell.active:hover, .ngx-datatable.material.cell-selection .datatable-body-cell.active:hover .datatable-row-group { background-color: rgb(25, 58, 228); color: rgb(255, 255, 255); }

.ngx-datatable.material.cell-selection .datatable-body-cell.active:focus, .ngx-datatable.material.cell-selection .datatable-body-cell.active:focus .datatable-row-group { background-color: rgb(32, 65, 239); color: rgb(255, 255, 255); }

