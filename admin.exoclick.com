exo-date-range-picker .mat-icon, .date-range-picker .mat-icon { width: 20px; height: 20px; font-size: 20px; }

.default-options-container .option-ele { color: rgba(0, 0, 0, 0.34); padding: 8px 10px !important; }

.default-options-container .option-ele:focus { outline: none; }

.default-options-container .option-ele.active, .default-options-container .option-ele:hover { color: var(--brandPrimaryDefaultColor); }

@media screen and (max-width: 450px) {
  .default-options-container .option-ele { padding: 8px 2px !important; font-size: 12px !important; }
}

@media screen and (max-width: 320px) {
  .default-options-container .option-ele { font-size: 10px !important; }
}

@media screen and (max-width: 400px) {
  .custom-calendar-container .footer-content .buttons { margin: 0px !important; }
  .custom-calendar-container .row-2 { padding-right: 16px !important; padding-left: 16px !important; }
}

