  .page-content__title { padding: 0px 20px; font-size: 14px; }
  .page-content__subtitle { padding: 0px 20px; }
}

.browsers { float: left; width: 40%; margin: auto 30%; }

.browsers__details { display: inline-block; float: left; width: 20%; text-align: center; font-size: 14px; line-height: 16px; }

.browsers__logo { max-width: 65px; width: 100%; }

.browsers__title { color: rgba(0, 0, 0, 0.6); margin-top: 21px; float: left; width: 100%; }

.browsers__version { color: rgba(0, 0, 0, 0.38); float: left; width: 100%; }

@media screen and (max-width: 1000px) {
  .browsers { width: 100%; margin: auto; }
}

@media screen and (max-width: 500px) {
  .browsers__details { margin-bottom: 21px; width: 100%; }
}
