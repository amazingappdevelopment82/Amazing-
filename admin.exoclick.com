.ngx-datatable.material .datatable-header .datatable-header-cell .datatable-header-cell-wrapper { position: relative; }

.ngx-datatable.material .datatable-header .datatable-header-cell.longpress .draggable::after { transition: transform 0.4s, opacity 0.4s; opacity: 0.5; transform: scale(1); }

.ngx-datatable.material .datatable-header .datatable-header-cell .draggable::after { content: " "; position: absolute; top: 50%; left: 50%; margin: -30px 0px 0px -30px; height: 60px; width: 60px; background: rgb(238, 238, 238); border-radius: 100%; opacity: 1; filter: none; transform: scale(0); z-index: 9999; pointer-events: none; }

.ngx-datatable.material .datatable-header .datatable-header-cell.dragging .resize-handle { border-right: none; }

.ngx-datatable.material .datatable-header .resize-handle { border-right: 1px solid rgb(238, 238, 238); }

.ngx-datatable.material .datatable-body { position: relative; }

.ngx-datatable.material .datatable-body .datatable-row-detail { background: rgb(245, 245, 245); padding: 10px; }

.ngx-datatable.material .datatable-body .datatable-group-header { background: rgb(245, 245, 245); border-bottom: 1px solid rgb(217, 216, 217); border-top: 1px solid rgb(217, 216, 217); }

.ngx-datatable.material .datatable-body .datatable-body-row .datatable-body-cell, .ngx-datatable.material .datatable-body .datatable-body-row .datatable-body-group-cell { text-align: left; padding: 0.9rem 1.2rem; vertical-align: top; border-top: 0px; color: rgba(0, 0, 0, 0.87); transition: width 0.3s; font-size: 14px; font-weight: 400; }

.ngx-datatable.material .datatable-body .progress-linear { display: block; position: sticky; width: 100%; height: 5px; padding: 0px; margin: 0px; top: 0px; }

.ngx-datatable.material .datatable-body .progress-linear .container { display: block; position: relative; overflow: hidden; width: 100%; height: 5px; transform: translate(0px) scale(1); background-color: rgb(170, 209, 249); }

.ngx-datatable.material .datatable-body .progress-linear .container .bar { animation: 0.8s cubic-bezier(0.39, 0.575, 0.565, 1) 0s infinite normal none running query; transition: transform 0.2s linear; background-color: rgb(16, 108, 200); position: absolute; left: 0px; top: 0px; bottom: 0px; width: 100%; height: 5px; }

.ngx-datatable.material .datatable-footer { border-top: 1px solid rgba(0, 0, 0, 0.12); font-size: 12px; font-weight: 400; color: rgba(0, 0, 0, 0.54); }

.ngx-datatable.material .datatable-footer .page-count { line-height: 50px; height: 50px; padding: 0px 1.2rem; }

.ngx-datatable.material .datatable-footer .datatable-pager { margin: 0px 10px; }

.ngx-datatable.material .datatable-footer .datatable-pager li { vertical-align: middle; }

.ngx-datatable.material .datatable-footer .datatable-pager li.disabled a { color: rgba(0, 0, 0, 0.26) !important; background-color: transparent !important; }

.ngx-datatable.material .datatable-footer .datatable-pager li.active a { background-color: rgba(158, 158, 158, 0.2); font-weight: 700; }

.ngx-datatable.material .datatable-footer .datatable-pager a { height: 22px; min-width: 24px; line-height: 22px; padding: 0px 6px; border-radius: 3px; margin: 6px 3px; text-align: center; color: rgba(0, 0, 0, 0.54); text-decoration: none; vertical-align: bottom; }

.ngx-datatable.material .datatable-footer .datatable-pager a:hover { color: rgba(0, 0, 0, 0.75); background-color: rgba(158, 158, 158, 0.2); }

.ngx-datatable.material .datatable-footer .datatable-pager .datatable-icon-left, .ngx-datatable.material .datatable-footer .datatable-pager .datatable-icon-skip, .ngx-datatable.material .datatable-footer .datatable-pager .datatable-icon-right, .ngx-datatable.material .datatable-footer .datatable-pager .datatable-icon-prev { font-size: 20px; line-height: 20px; padding: 0px 3px; }

.ngx-datatable.material .datatable-summary-row .datatable-body-row, .ngx-datatable.material .datatable-summary-row .datatable-body-row:hover { background-color: rgb(221, 221, 221); }

.ngx-datatable.material .datatable-summary-row .datatable-body-row .datatable-body-cell { font-weight: 700; }

.datatable-checkbox { position: relative; margin: 0px; cursor: pointer; vertical-align: middle; display: inline-block; box-sizing: border-box; padding: 0px; }

.datatable-checkbox input[type="checkbox"] { position: relative; margin: 0px 1rem 0px 0px; cursor: pointer; outline: none; }

.datatable-checkbox input[type="checkbox"]::before { transition: 0.3s ease-in-out; content: ""; position: absolute; left: 0px; z-index: 1; width: 1rem; height: 1rem; border: 2px solid rgb(242, 242, 242); }

.datatable-checkbox input[type="checkbox"]:checked::before { transform: rotate(-45deg); height: 0.5rem; border-color: rgb(0, 150, 136); border-top-style: none; border-right-style: none; }

.datatable-checkbox input[type="checkbox"]::after { content: ""; position: absolute; top: 0px; left: 0px; width: 1rem; height: 1rem; background: rgb(255, 255, 255); cursor: pointer; }

@keyframes query { 
  0% { opacity: 1; transform: translate(35%) scaleX(0.3); }
  100% { opacity: 0; transform: translate(-50%) scaleX(0); }
}

