body { font-family: Roboto, "Helvetica Neue", sans-serif; font-size: 14px; background-color: rgb(250, 250, 250); color: rgba(0, 0, 0, 0.87); }

* { font-family: Roboto, "Helvetica Neue", sans-serif; -webkit-font-smoothing: initial !important; }

body, html { height: 100%; margin: 0px; }

:disabled, .mat-checkbox-disabled, .mat-form-field-disabled, .mat-select-disabled, .mat-select-disabled .mat-select-trigger, [aria-disabled="true"] { cursor: no-drop !important; }

:disabled .mat-select-arrow, .mat-checkbox-disabled .mat-select-arrow, .mat-form-field-disabled .mat-select-arrow, .mat-select-disabled .mat-select-arrow, .mat-select-disabled .mat-select-trigger .mat-select-arrow, [aria-disabled="true"] .mat-select-arrow { color: rgba(0, 0, 0, 0.34); }

exa-root, exa-admin-panel { display: block; height: 100%; }

a { color: var(--brandPrimaryDefaultColor); cursor: pointer; }

a:hover, a:focus { color: var(--brandPrimaryDefaultColor); }

ul { list-style: none; margin: 0px; padding: 0px; }

img { width: 100%; }

label { font-weight: 400; font-size: 12px; color: rgba(0, 0, 0, 0.34); margin-bottom: 0px; }

.section-label { font-size: 16px; font-weight: 500; }

input, textarea, select { font-size: 14px; }

input:focus, textarea:focus, select:focus { font-size: 14px; }

input.form-control, textarea.form-control, select.form-control { font-size: 14px; }

input.form-control::placeholder, textarea.form-control::placeholder, select.form-control::placeholder { font-size: 12px; }

@media (min-width: 768px) {
  input, textarea, select { font-size: 14px; }
  input:focus, textarea:focus, select:focus { font-size: 14px; }
}

textarea { box-sizing: border-box; width: 100%; }

.material-symbols-outlined { color: rgba(0, 0, 0, 0.6); }

.mat-step-header { text-align: center; }

.mat-step-header .mat-step-icon-selected .mat-icon.material-icons, .mat-step-header .mat-step-icon-state-done .mat-icon.material-icons, .mat-step-header .mat-step-icon-state-edit .mat-icon.material-icons { color: rgb(255, 255, 255); }

.mat-step-header .mat-step-icon-state-error .mat-icon.material-icons { color: rgb(242, 77, 77); font-size: 29px; height: 31px; width: 31px; }

